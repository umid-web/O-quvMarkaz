{
  "name": "boshqaruv",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test:api": "node --test Back-end/tests/*.test.js",
    "verify": "npm run lint && npm run test:api && npm run build",
    "db:backup": "node --env-file-if-exists=Back-end/.env Back-end/backup.js",
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api": "node --env-file-if-exists=Back-end/.env Back-end/index.js",
    "api:dev": "node --watch --env-file-if-exists=Back-end/.env Back-end/index.js",
    "start": "node --env-file-if-exists=Back-end/.env Back-end/index.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "lucide-react": "^1.58.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "sass": "^1.105.2",
    "vite": "^8.3.0"
  }
}
